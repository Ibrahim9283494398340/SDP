@model OxuMen.ViewModels.EditTeacherViewModel

@{
    ViewData["Title"] = "Edit Teacher";

    var classPicker = new OxuMen.ViewModels.ClassPickerViewModel
    {
        FieldName = "Input.Classes",
        Selected = Model.Input.Classes
    };
}

<h1>@Model.UserName</h1>
<p class="text-muted">Choose the classes this teacher sees.</p>

<div class="row mt-4">
    <div class="col-lg-8">
        <form asp-controller="Admin"
              asp-action="EditTeacher"
              asp-route-id="@Model.Id"
              method="post">

            <div asp-validation-summary="All"
                 class="text-danger mb-3"
                 role="alert"></div>

            <partial name="_ClassPicker" model="classPicker" />

            <button type="submit" class="btn btn-primary">
                Save
            </button>

            <a asp-action="Teachers" class="btn btn-outline-secondary">
                Cancel
            </a>
        </form>
    </div>
</div>

