@model OxuMen.ViewModels.AdminStudentsViewModel

@{
    ViewData["Title"] = "All Students";

    var groupOptions = OxuMen.Models.SchoolGroups.All;
}

@if (TempData["SuccessMessage"] is string message)
{
    <div class="alert alert-success" role="status">@message</div>
}

@if (TempData["ErrorMessage"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

<h1>All Students</h1>
<p class="text-muted">
    Every student in the school. Choose a new class and press
    <strong>Move</strong> to change a student's class; their results move
    with them.
</p>

<form asp-controller="Admin"
      asp-action="Students"
      method="get"
      class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <label for="filter-group" class="form-label mb-0">Show class:</label>

    <select id="filter-group" name="group" class="form-select w-auto">
        <option value="">All classes</option>

        @foreach (var option in groupOptions)
        {
            <option value="@option" selected="@(option == Model.Group)">@option</option>
        }
    </select>

    <button type="submit" class="btn btn-outline-primary">Show</button>
</form>

<p class="text-muted">Students: @Model.Students.Count</p>

@if (Model.Students.Count == 0)
{
    <div class="alert alert-info">No students here yet.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th scope="col">Name</th>
                    <th scope="col">Class</th>
                    <th scope="col">Account</th>
                    <th scope="col">Move to class</th>
                    <th scope="col"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Students)
                {
                    var selectId = $"move-{row.Student.Id}";

                    <tr>
                        <th scope="row">
                            @row.Student.FirstName @row.Student.LastName
                        </th>

                        <td>
                            <span class="badge bg-primary">@row.ClassGroup</span>
                        </td>

                        <td>
                            @(row.UserName ?? "Not signed up")
                        </td>

                        <td>
                            <form asp-controller="Admin"
                                  asp-action="ChangeClass"
                                  asp-route-id="@row.Student.Id"
                                  method="post"
                                  class="d-flex gap-2">

                                <input type="hidden"
                                       name="returnGroup"
                                       value="@Model.Group" />

                                <label for="@selectId" class="visually-hidden">
                                    New class for @row.Student.FirstName
                                </label>

                                <select id="@selectId"
                                        name="classGroup"
                                        class="form-select form-select-sm w-auto">
                                    @foreach (var option in groupOptions)
                                    {
                                        <option value="@option" selected="@(option == row.ClassGroup)">@option</option>
                                    }
                                </select>

                                <button type="submit"
                                        class="btn btn-sm btn-outline-primary">
                                    Move
                                </button>
                            </form>
                        </td>

                        <td>
                            <a asp-controller="StudentPages"
                               asp-action="Details"
                               asp-route-id="@row.Student.Id"
                               class="btn btn-sm btn-outline-secondary">
                                View
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
