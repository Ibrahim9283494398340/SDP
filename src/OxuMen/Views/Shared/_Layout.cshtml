<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — OxuMən</title>
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <div class="app-shell">
        <aside class="sidebar">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <span aria-hidden="true">📖</span> OxuMən
            </a>

            <p class="brand-caption">Read. Understand. Grow.</p>

            <div class="role-label">TEACHER DASHBOARD</div>

            <nav aria-label="Main navigation">
                <a asp-controller="Home" asp-action="Index">
                    Overview
                </a>

                <a asp-controller="Home"
                   asp-action="Index"
                   asp-fragment="students">
                    Students
                </a>

                <a asp-controller="Home"
                   asp-action="Index"
                   asp-fragment="workflow">
                    Learning Journey
                </a>
            </nav>

            <div class="sidebar-note">
                Supporting teachers.<br />
                Helping every student grow.
            </div>
        </aside>

        <div class="workspace">
            <header class="topbar">
                <span>OxuMən Learning Platform</span>
                <span class="workspace-badge">Teacher Workspace</span>
            </header>

            <main id="main-content" class="page" tabindex="-1">
                @RenderBody()
            </main>

            <footer>
                OxuMən · Reading support for primary school students
            </footer>
        </div>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>