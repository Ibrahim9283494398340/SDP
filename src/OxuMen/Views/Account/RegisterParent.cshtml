@model OxuMen.Models.ParentRegisterRequest

@{
    ViewData["Title"] = "Create a Parent Account";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-7 col-lg-5">
        <h1 class="h3 mb-2">Create a parent account</h1>
        <p class="text-muted mb-4">
            You need your child's <strong>parent code</strong>. Your child
            can find it on their <em>My Page</em>, or ask their teacher.
        </p>

        <form asp-controller="Account"
              asp-action="RegisterParent"
              method="post">

            <div asp-validation-summary="All"
                 class="text-danger mb-3"
                 role="alert"></div>

            <div class="mb-3">
                <label asp-for="ChildCode" class="form-label"></label>
                <input asp-for="ChildCode"
                       class="form-control text-uppercase"
                       placeholder="ABCD-1234"
                       autocomplete="off" />
            </div>

            <div class="mb-3">
                <label asp-for="UserName" class="form-label"></label>
                <input asp-for="UserName"
                       class="form-control"
                       autocomplete="username" />
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password"
                       class="form-control"
                       autocomplete="new-password" />
            </div>

            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword"
                       class="form-control"
                       autocomplete="new-password" />
            </div>

            <button type="submit" class="btn btn-primary w-100">
                Create Parent Account
            </button>
        </form>

        <p class="mt-3">
            Already have an account?
            <a asp-controller="Account" asp-action="Login">Sign in</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
