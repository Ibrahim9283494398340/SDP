
@{
    ViewData["Title"] = "Müəllim Paneli";

    // Demo values from the existing homepage.
    // These are not yet connected to stored assessment data.
    var students = new[]
    {
        new { Name = "Aylin M.", Speed = 62, Accuracy = 94, Comprehension = 7 },
        new { Name = "Rashad A.", Speed = 48, Accuracy = 88, Comprehension = 6 },
        new { Name = "Zahra K.", Speed = 71, Accuracy = 97, Comprehension = 8 },
        new { Name = "Murad H.", Speed = 36, Accuracy = 82, Comprehension = 4 }
    };

    var averageAccuracy = students.Average(s => s.Accuracy);
    var averageSpeed = students.Average(s => s.Speed);
}

<div class="ox-page-heading">
    <div>
        <div class="ox-eyebrow">MÜƏLLİM PANELİ</div>
        <h1>Xoş gəlmisiniz! 👋</h1>
        <p>Şagirdlərinizin oxu bacarıqlarını izləyin və inkişafına dəstək olun.</p>
    </div>
    <span class="ox-role-tag">👩‍🏫 Müəllim</span>
</div>

<section class="ox-hero">
    <div class="ox-hero-text">
        <span class="ox-hero-tag">✨ OxuMən ilə öyrənmək daha əyləncəlidir</span>
        <h2>Hər şagirdin uğur hekayəsi burada başlayır!</h2>
        <p>
            Oxu sürəti, düzgünlük və anlama bacarıqlarını
            bir yerdən izləyin.
        </p>
        <a class="ox-hero-button" asp-controller="StudentPages" asp-action="Index">
            Şagirdlərə bax →
        </a>
    </div>
    <div class="ox-hero-art" aria-hidden="true">
        <span class="ox-floating-star">⭐</span>
        <span class="ox-hero-book">📚</span>
        <span class="ox-floating-pencil">✏️</span>
    </div>
</section>

<section class="ox-section">
    <div class="ox-section-heading">
        <div>
            <span class="ox-eyebrow">ÜMUMİ GÖSTƏRİCİLƏR</span>
            <h2>Sinifin nəticələri</h2>
        </div>
        <span class="ox-pill">3-cü sinif · Nümunə məlumatlar</span>
    </div>

    <div class="ox-stats-grid">
        <article class="ox-stat-card">
            <div class="ox-stat-icon ox-blue">👥</div>
            <span>Şagird sayı</span>
            <strong>@students.Length</strong>
            <small>Sinifdəki şagirdlər</small>
        </article>

        <article class="ox-stat-card">
            <div class="ox-stat-icon ox-green">📖</div>
            <span>Orta oxu sürəti</span>
            <strong>@averageSpeed.ToString("0")</strong>
            <small>Söz / dəqiqə</small>
        </article>

        <article class="ox-stat-card">
            <div class="ox-stat-icon ox-purple">🎯</div>
            <span>Orta düzgünlük</span>
            <strong>@averageAccuracy.ToString("0")%</strong>
            <small>Oxu dəqiqliyi</small>
        </article>

        <article class="ox-stat-card">
            <div class="ox-stat-icon ox-orange">🏆</div>
            <span>Sinif səviyyəsi</span>
            <strong>3</strong>
            <small>İbtidai təhsil</small>
        </article>
    </div>
</section>

<section class="ox-section">
    <div class="ox-section-heading">
        <div>
            <span class="ox-eyebrow">TƏDRİS PROSESİ</span>
            <h2>İdarəetmə paneli</h2>
        </div>
    </div>

    <div class="ox-feature-grid">
        <a class="ox-feature-card" asp-controller="StudentPages" asp-action="Index">
            <div class="ox-feature-art ox-feature-blue">👩‍🎓</div>
            <div class="ox-feature-body">
                <h3>Şagirdlər</h3>
                <p>Şagird profillərinə və qruplara baxın.</p>
                <span>İdarə et →</span>
            </div>
        </a>

        <a class="ox-feature-card" asp-controller="GroupTasks" asp-action="Index">
            <div class="ox-feature-art ox-feature-purple">📝</div>
            <div class="ox-feature-body">
                <h3>Tapşırıqlar</h3>
                <p>Qrup tapşırıqlarını idarə edin.</p>
                <span>Tapşırıqlara bax →</span>
            </div>
        </a>

        <a class="ox-feature-card" asp-controller="AssessmentPages" asp-action="Index">
            <div class="ox-feature-art ox-feature-orange">📊</div>
            <div class="ox-feature-body">
                <h3>Qiymətləndirmə</h3>
                <p>Oxu bacarıqlarını qiymətləndirin.</p>
                <span>Nəticələrə bax →</span>
            </div>
        </a>
    </div>
</section>

<div class="ox-bottom-grid">
    <section class="ox-panel">
        <div class="ox-section-heading">
            <div>
                <span class="ox-eyebrow">OXU NƏTİCƏLƏRİ</span>
                <h2>Şagirdlərin göstəriciləri</h2>
            </div>
        </div>

        <div class="ox-table-scroll">
            <table class="ox-table">
                <thead>
                    <tr>
                        <th>Şagird</th>
                        <th>Oxu sürəti</th>
                        <th>Düzgünlük</th>
                        <th>Anlama</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var student in students)
                    {
                        <tr>
                            <td>
                                <span class="ox-table-avatar">
                                    @student.Name.Substring(0, 1)
                                </span>
                                @student.Name
                            </td>
                            <td>@student.Speed söz/dəq</td>
                            <td>
                                <div class="ox-progress-value">@student.Accuracy%</div>
                                <div class="ox-progress-track">
                                    <div class="ox-progress-fill"
                                         style="width: @(student.Accuracy)%"></div>
                                </div>
                            </td>
                            <td>@student.Comprehension / 10</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="ox-data-note">
            Bu göstəricilər nümunə məlumatlardır.
            Nəticələr müəllim tərəfindən qiymətləndirilməlidir.
        </p>
    </section>

    <aside class="ox-panel ox-goals-panel">
        <span class="ox-eyebrow">ÖYRƏNMƏ YOLU</span>
        <h2>İnkişaf addımları</h2>

        <div class="ox-goal-item">
            <span class="ox-goal-number">1</span>
            <div>
                <strong>Şagird profili</strong>
                <p>Şagird haqqında məlumat yaradın.</p>
            </div>
        </div>

        <div class="ox-goal-item">
            <span class="ox-goal-number">2</span>
            <div>
                <strong>İlkin qiymətləndirmə</strong>
                <p>Oxu bacarıqlarını yoxlayın.</p>
            </div>
        </div>

        <div class="ox-goal-item">
            <span class="ox-goal-number">3</span>
            <div>
                <strong>Fərdi inkişaf planı</strong>
                <p>Müəllim təsdiqi ilə plan hazırlayın.</p>
            </div>
        </div>

        <div class="ox-goal-item">
            <span class="ox-goal-number">4</span>
            <div>
                <strong>İnkişafı izləyin</strong>
                <p>Təkrar qiymətləndirmə aparın.</p>
            </div>
        </div>
    </aside>
</div>
