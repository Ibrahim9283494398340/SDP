@model System.Collections.Generic.Dictionary<string, int>

@{
    ViewData["Title"] = "Groups";
}

@if (TempData["SuccessMessage"] is string message)
{
    <div class="alert alert-success" role="status">
        @message
    </div>
}

<div class="mb-4">
    <h1>Groups</h1>
    <p class="text-muted">Select a group to view its students.</p>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        You have no classes yet. Ask the administrator to assign your
        classes to you.
    </div>
}

@foreach (var grade in Model.Keys.GroupBy(group => group[0]))
{
    <h2 class="h5 mb-3">Grade @grade.Key</h2>

    <div class="row g-3 mb-4">
        @foreach (var groupName in grade)
        {
            <div class="col-6 col-md-3">
                <a asp-controller="StudentPages"
                   asp-action="Group"
                   asp-route-group="@groupName"
                   class="card h-100 text-decoration-none text-dark shadow-sm">
                    <div class="card-body text-center py-4">
                        <h3 class="h2 text-primary">@groupName</h3>
                        <p class="text-muted mb-0">
                            Students: @Model[groupName]
                        </p>
                    </div>
                </a>
            </div>
        }
    </div>
}
