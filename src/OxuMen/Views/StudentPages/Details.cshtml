@model OxuMen.Models.Student

@{
    ViewData["Title"] = "Student Details";
    var loginUserName = ViewData["LoginUserName"] as string;
    var parentCode = ViewData["ParentCode"] as string;
    var parents = ViewData["Parents"] as List<OxuMen.Models.AppUser>
        ?? new List<OxuMen.Models.AppUser>();
}

@if (TempData["SuccessMessage"] is string message)
{
    <div class="alert alert-success" role="status">
        @message
    </div>
}

<h1>Student Details</h1>

<div class="card mt-4">
    <div class="card-body">
        <h2 class="h4 mb-4">
            @Model.FirstName @Model.LastName
        </h2>

        <dl class="row">
            <dt class="col-sm-3">Student ID</dt>
            <dd class="col-sm-9 text-break">@Model.Id</dd>

            <dt class="col-sm-3">First Name</dt>
            <dd class="col-sm-9">@Model.FirstName</dd>

            <dt class="col-sm-3">Last Name</dt>
            <dd class="col-sm-9">@Model.LastName</dd>

            <dt class="col-sm-3">Grade Level</dt>
            <dd class="col-sm-9">@Model.GradeLevel</dd>

            <dt class="col-sm-3">Class Group</dt>
            <dd class="col-sm-9">@Model.ClassGroup</dd>

            <dt class="col-sm-3">Login</dt>
            <dd class="col-sm-9">
                @(loginUserName ?? "Has not created an account yet")
            </dd>

            <dt class="col-sm-3">Parent code</dt>
            <dd class="col-sm-9">
                <span class="font-monospace">@parentCode</span>
                <div class="small text-muted">
                    A parent enters this code to create a parent account
                    linked to this student.
                </div>
            </dd>

            <dt class="col-sm-3">Parents</dt>
            <dd class="col-sm-9">
                @if (parents.Count == 0)
                {
                    <span>No parent linked yet</span>
                }
                else
                {
                    foreach (var parent in parents)
                    {
                        <div class="mb-1">
                            @parent.UserName
                            <a asp-controller="Messages"
                               asp-action="Conversation"
                               asp-route-studentId="@Model.Id"
                               asp-route-otherUserId="@parent.Id"
                               class="btn btn-sm btn-outline-primary ms-2">
                                Message
                            </a>
                        </div>
                    }
                }
            </dd>

            <dt class="col-sm-3">Created (UTC)</dt>
            <dd class="col-sm-9">
                @Model.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm")
            </dd>
        </dl>

        <div class="d-flex flex-wrap gap-2">
            <a asp-controller="AssessmentPages"
               asp-action="Create"
               asp-route-studentId="@Model.Id"
               class="btn btn-success">
                Add Assessment
            </a>

            <a asp-controller="AssessmentPages"
               asp-action="Index"
               asp-route-studentId="@Model.Id"
               class="btn btn-outline-primary">
                Assessment History
            </a>

            @if (loginUserName is not null)
            {
                <a asp-controller="StudentLogins"
                   asp-action="Manage"
                   asp-route-id="@Model.Id"
                   class="btn btn-outline-dark">
                    Reset Password
                </a>
            }

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-primary">
                Edit Student
            </a>

            <a asp-action="Delete"
               asp-route-id="@Model.Id"
               class="btn btn-outline-danger">
                Delete Student
            </a>

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                Back to Students
            </a>
        </div>
    </div>
</div>