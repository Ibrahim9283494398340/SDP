@model OxuMen.ViewModels.AssessmentPageViewModel

@{
    ViewData["Title"] = "Result";
    var assessment = Model.Assessment!;
}

<h1>Result for @Model.Student.FirstName</h1>

<p class="text-muted">
    @assessment.TextReference · Version @assessment.TextVersion
    · @assessment.Kind
    · @assessment.AssessedAtUtc.ToUniversalTime().ToString("yyyy-MM-dd HH:mm") UTC
</p>

<div class="card mb-4">
    <div class="card-body">
        <h2 class="h5">Teacher's Note</h2>

        @if (string.IsNullOrWhiteSpace(assessment.Notes))
        {
            <p class="text-muted mb-0">The teacher did not add a note.</p>
        }
        else
        {
            <p class="mb-0" style="white-space: pre-wrap;">@assessment.Notes</p>
        }
    </div>
</div>

<div class="table-responsive mb-4">
    <table class="table table-bordered">
        <caption>
            Each reading measure is shown separately. These figures are not a
            diagnosis; talk to the teacher about what they mean.
        </caption>

        <thead>
            <tr>
                <th scope="col">Measure</th>
                <th scope="col">Result</th>
            </tr>
        </thead>

        <tbody>
            <tr>
                <th scope="row">Words read</th>
                <td>@assessment.TotalWordsRead</td>
            </tr>
            <tr>
                <th scope="row">Words read correctly</th>
                <td>@assessment.CorrectWordsRead</td>
            </tr>
            <tr>
                <th scope="row">Time</th>
                <td>@assessment.DurationSeconds.ToString("0.##") seconds</td>
            </tr>
            <tr>
                <th scope="row">Reading speed</th>
                <td>@(assessment.WordsPerMinute?.ToString("0.##") ?? "N/A") words/min</td>
            </tr>
            <tr>
                <th scope="row">Correct words per minute</th>
                <td>@(assessment.CorrectWordsPerMinute?.ToString("0.##") ?? "N/A") correct words/min</td>
            </tr>
            <tr>
                <th scope="row">Accuracy</th>
                <td>
                    @(assessment.AccuracyPercentage.HasValue
                        ? assessment.AccuracyPercentage.Value.ToString("0.##") + "%"
                        : "N/A")
                </td>
            </tr>
            <tr>
                <th scope="row">Comprehension</th>
                <td>
                    @if (assessment.ComprehensionTotalQuestions.HasValue)
                    {
                        <span>
                            @assessment.ComprehensionCorrectAnswers out of
                            @assessment.ComprehensionTotalQuestions
                        </span>
                    }
                    else
                    {
                        <span>Not assessed</span>
                    }
                </td>
            </tr>
        </tbody>
    </table>
</div>

<a asp-controller="Parent"
   asp-action="Child"
   asp-route-id="@Model.Student.Id"
   class="btn btn-primary">
    Back
</a>
