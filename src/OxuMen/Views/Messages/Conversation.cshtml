@model OxuMen.ViewModels.ConversationViewModel

@{
    ViewData["Title"] = $"Messages with {Model.OtherUserName}";
    var canSend = ViewData["CanSend"] is true;
}

<h1 class="h3">Messages with @Model.OtherUserName</h1>

<p class="text-muted">
    @(Model.OtherRole == "teacher" ? "Teacher" : "Parent")
    · about @Model.Student.FirstName @Model.Student.LastName
    (group @Model.Student.ClassGroup)
</p>

<a asp-controller="Messages"
   asp-action="Index"
   class="btn btn-outline-secondary btn-sm mb-3">
    All Messages
</a>

<div class="mb-4" style="max-width: 44rem;">
    @if (Model.Messages.Count == 0)
    {
        <div class="alert alert-light border">
            No messages yet. Write the first one below.
        </div>
    }

    @foreach (var message in Model.Messages)
    {
        var mine = message.SenderUserId == Model.MyUserId;

        <div class="d-flex @(mine ? "justify-content-end" : "justify-content-start") mb-2">
            <div class="p-2 rounded border @(mine ? "bg-primary-subtle" : "bg-light")"
                 style="max-width: 80%;">
                <div class="small text-muted mb-1">
                    @(mine ? "You" : Model.OtherUserName)
                    · @message.SentAtUtc.ToString("yyyy-MM-dd HH:mm") UTC
                </div>
                <div style="white-space: pre-wrap;">@message.Body</div>
            </div>
        </div>
    }
</div>

@if (canSend)
{
    <form asp-controller="Messages"
          asp-action="Send"
          asp-route-studentId="@Model.Student.Id"
          asp-route-otherUserId="@Model.OtherUserId"
          method="post"
          style="max-width: 44rem;">

        <div asp-validation-summary="All"
             class="text-danger mb-2"
             role="alert"></div>

        <div class="mb-2">
            <label asp-for="Input.Body" class="form-label"></label>
            <textarea asp-for="Input.Body"
                      class="form-control"
                      rows="4"
                      maxlength="2000"></textarea>
        </div>

        <button type="submit" class="btn btn-primary">Send</button>
    </form>
}
else
{
    <div asp-validation-summary="All" class="text-danger mb-2" role="alert"></div>

    <div class="alert alert-warning" style="max-width: 44rem;">
        You can read this conversation, but not reply: the child or the class
        is no longer linked to you.
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
